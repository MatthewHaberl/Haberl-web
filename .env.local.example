# Copy this file to .env.local and fill in the values, then `npm run dev`.
# .env.local is gitignored — never commit real secrets. See DEPLOY.md for where
# each value comes from.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. Never expose to the client / never prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (required) ────────────────────────────────────────────────────────
# Drives links in emails and the public quote URLs. Use http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email — Resend (required for any email to send) ───────────────────────────
# resend.com → API Keys (verify the haberl.co.za domain first)
RESEND_API_KEY=

# ── Cron secrets ──────────────────────────────────────────────────────────────
# Any long random string. Vercel Cron sends it as a Bearer token automatically.
CRON_SECRET=
# Used by the VPS crontab that hits /api/monitoring/collect (if monitoring is used).
MONITORING_CRON_SECRET=

# ── Google (roof designer + address autocomplete) ─────────────────────────────
# Server-only key, NO referrer restriction (Solar + Geocoding).
GOOGLE_SOLAR_API_KEY=
# Server-only key for Places autocomplete (Places API enabled, NO referrer restriction).
# Falls back to GOOGLE_SOLAR_API_KEY if unset.
GOOGLE_MAPS_SERVER_KEY=
# Browser key for Maps JS — restrict by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Geocoding (OpenStreetMap Nominatim) ───────────────────────────────────────
NOMINATIM_USER_AGENT=haberl-web/1.0 (you@example.com)

# ── Monitoring credential encryption ──────────────────────────────────────────
# 64-character hex string (32 bytes) — AES-256-GCM key for stored brand API creds.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONITORING_CREDENTIALS_KEY=

# ── Legacy AI quotes (optional — leave unset to keep disabled) ────────────────
ENABLE_AI_QUOTES=
ANTHROPIC_API_KEY=

# ── Dev portal preview logins (optional) ──────────────────────────────────────
# Required by scripts/create-dev-users.mjs — no default is provided. Use a strong value.
DEV_PORTAL_PASSWORD=

# ── PayFast (Phase 2 shop checkout — optional, sandbox until launch) ───────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
