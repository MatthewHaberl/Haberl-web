{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/quote-followups",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/key-refresh",
      "schedule": "45 3 * * *"
    }
  ]
}
